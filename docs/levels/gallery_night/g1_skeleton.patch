+## Gallery Night gameplay layer (STUB, GN-C1 skeleton). Owner: ENV C.
+## Builds every VariantSlot of the map (groups in resolver order, ids and base weights from the layout data, which
+## tools/levelcheck/plans/gallery_night_slots.py --check keeps in step with the doc and ENV B's variant table)
+## with placeholder content, and the empty Gameplay groups. The G1 build replaces each placeholder with ENV A's
+## prefab instances (loot_spawn, keycard_pickup, code_note, security_camera, laser_grid, padlock, door, NPC
+## SpawnPoints...), located by contract class name as in sl_gameplay.gd, never by a path into game/systems.
+extends "res://world/heists/gallery_night/greybox/gn_builder_base.gd"
+
+## Argus code group for the SV keypad and the code notes (B2).
+const CODE_GROUP: StringName = &"argus"
+## What each group's slot content will be (the placeholder's `todo`).
+const SLOT_TODO: Dictionary = {
+	"centrepiece": "loot_spawn loot.painting_lantern_bearer, objective_tag canvas_lantern, alarm group (sensor_net)",
+	"canvas_orchard": "loot_spawn loot.painting_salt_orchard, objective_tag canvas_orchard",
+	"canvas_widow": "loot_spawn loot.painting_widow_in_blue, objective_tag canvas_widow",
+	"canvas_saint": "loot_spawn loot.painting_tidewater_saint, objective_tag canvas_saint",
+	"sensor_net": "logic slot: params alarm_group / alarmed slot list for the mission (QC-54)",
+	"conservator": "CIVILIAN SpawnPoint civ_conservator (cons_late) / empty (cons_gone)",
+	"keycard": "keycard_pickup objective_tag keycard (kc_curator: NPC-carried, QC-52)",
+	"code_note": "code_note code_group argus, objective_tag code_note",
+	"guard_post": "GUARD SpawnPoint + PatrolGraph post (rover_none: empty)",
+	"security_room_staffed": "CAMERA_OPERATOR SpawnPoint at the SC console (sec_staffed) / empty",
+	"camera": "security_camera instances of this layout (C* placeholders below)",
+	"laser_pattern": "laser_grid TR z 26.5 with this pattern (B4: low beam centre >= 1.30 m)",
+	"curator_route": "civ_curator SpawnPoint + staff_curator PatrolPoints",
+	"court_doors": "door prefab at the WG French doors (NONE until last call / LOCKPICK)",
+	"areaway": "grate (lift 3 s) / padlock prefab (lockpick 8 s or saw); ladder to PL",
+	"escape": "escape_zone + secure_zone + vehicle visual (van / limo)",
+	"xl_crate": "loan crate with extra loot.painting_study (late_loan)",
+	"admin_pa": "CIVILIAN SpawnPoint civ_admin at an AO desk (late_paperwork)",
+}
+
+
+## Variants: Group_<group> / Slot_<slot_id> (VariantSlot) at the slot's anchor, one placeholder child each; the
+## layout cameras under their cam_* slot; escape/secure zone placeholders under their escape slot.
+func build_variants(variants: Node3D) -> void:
+	var groups: Dictionary = {}
+	for g: String in L.GROUP_ORDER:
+		groups[g] = add(variants, node3d("Group_" + g))
+	for row: Array in L.SLOTS:
+		var g2: String = String(row[0])
+		var sid: String = String(row[1])
+		var at: Vector3 = Vector3(float(row[5]), float(row[6]), float(row[7]))
+		var params: Dictionary = {}
+		if g2 == "code_note":
+			params = {"code_group": CODE_GROUP}
+		var vs: VariantSlot = _slot(groups[g2], g2, sid, float(row[2]), at, params)
+		vs.set_meta(&"room", String(row[4]))
+		placeholder(vs, "Placeholder", at, "%s (%s)" % [SLOT_TODO.get(g2, "?"), String(row[8])])
+		if g2 == "camera":
+			_layout_cameras(vs, sid)
+		if g2 == "escape":
+			for z: Array in L.ESCAPE_ZONES:
+				if String(z[0]) == sid:
+					placeholder(vs, "%sZone" % String(z[1]).capitalize().replace(" ", ""),
+						Vector3(float(z[4]), float(z[5]), float(z[6])), "%s MapZone of %s" % [z[1], sid])
+
+
+func _slot(parent: Node3D, group: String, slot_id: String, weight: float, at: Vector3, params: Dictionary) -> VariantSlot:
+	var vs: VariantSlot = VariantSlot.new()
+	vs.name = "Slot_" + slot_id
+	vs.slot_group = StringName(group)
+	vs.slot_id = StringName(slot_id)
+	vs.weight = weight
+	vs.params = params
+	vs.position = at
+	add(parent, vs)
+	return vs
+
+
+func _layout_cameras(vs: VariantSlot, layout: String) -> void:
+	for c: Array in L.CAMERAS:
+		if (c[6] as Array).has(layout):
+			placeholder(vs, String(c[0]), Vector3(float(c[3]), float(c[4]), float(c[5])),
+				"security_camera %s (%s)" % [c[0], c[2]])
+
+
+## Gameplay: the always-present prefabs' groups. C11 and C14 are live in every layout (B6), so they sit here,
+## outside any slot. Everything else is a G1 to-do.
+func build_gameplay(gp: Node3D) -> void:
+	for nm: String in ["Doors", "Cameras", "Loot", "Devices", "Ladders", "Lifts", "Civilian"]:
+		add(gp, node3d(nm))
+	for c: Array in L.CAMERAS:
+		if (c[6] as Array).has("always"):
+			placeholder(n("Gameplay/Cameras"), String(c[0]), Vector3(float(c[3]), float(c[4]), float(c[5])),
+				"security_camera %s (%s), live in every layout" % [c[0], c[2]])
