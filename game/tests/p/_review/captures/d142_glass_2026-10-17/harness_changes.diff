diff --git a/game/tests/p/_review/glass_probe.gd b/game/tests/p/_review/glass_probe.gd
new file mode 100644
index 00000000..ca69ead3
--- /dev/null
+++ b/game/tests/p/_review/glass_probe.gd
@@ -0,0 +1,160 @@
+## D-142 re-walk probe (ENV P helper, 2026-10-17; scratch only): logs when an observer's line of sight to the pilot
+## exists ONLY through see-through glass (StealthDirector.GROUP_SEE_THROUGH), i.e. a sighting D-142 added.
+## Every PROBE_EVERY physics frames, for each active observer under the runtime: plain vision rays (VISION_MASK, no
+## see-through pass) and the D-142 rays (StealthDirector.vision_clear) from the observer's eye to the pilot at the LOS
+## heights. glass-only = some D-142 ray clear and no plain ray clear. Rows:
+##   [GLASS] SEEN <observer> meter m: meter > 0 while glass-only (first row per episode, then each +0.25 of meter)
+##   [GLASS] LOS <observer>: glass-only line within LOS_LOG_M and inside +-HALF_ANGLE of its facing (meter 0;
+##     once per observer per LOS_REPEAT_S game-s): a near miss to look at.
+## Read-only: no state writes, no input.
+extends Node
+
+const PROBE_EVERY: int = 3
+const LOS_LOG_M: float = 18.0
+const HALF_ANGLE_DEG: float = 60.0
+const LOS_REPEAT_S: float = 8.0
+const HEIGHTS: Array[float] = [1.6, 1.0]
+
+var rt: HeistRuntime = null
+var crew: CrewController = null
+var log_fn: Callable = Callable()
+var _frame: int = 0
+var _seen: Dictionary = {}  # observer name -> last logged quarter (-1 = none)
+var _los_t: Dictionary = {}  # observer name -> last LOS row game time
+var _peak: Dictionary = {}  # observer name -> [peak meter via glass, pane, pilot pos, obs pos]
+var _q: PhysicsRayQueryParameters3D = null
+
+
+static func attach(host: Node, runtime: HeistRuntime, c: CrewController, fn: Callable) -> Node:
+	var p: Node = load("res://tests/p/_review/glass_probe.gd").new()
+	p.name = "GlassProbe"
+	p.set(&"rt", runtime)
+	p.set(&"crew", c)
+	p.set(&"log_fn", fn)
+	p.process_mode = Node.PROCESS_MODE_ALWAYS
+	host.add_child(p)
+	return p
+
+
+func _ready() -> void:
+	_q = PhysicsRayQueryParameters3D.new()
+	_q.collision_mask = StealthDirector.VISION_MASK
+
+
+func _physics_process(_delta: float) -> void:
+	_frame += 1
+	if _frame % PROBE_EVERY != 0 or rt == null or not is_instance_valid(rt) or crew == null or not is_instance_valid(crew):
+		return
+	if rt.stealth == null or rt.stealth.alarm_raised:
+		return
+	for n: Node in get_tree().get_nodes_in_group(G.OBSERVER):
+		var o: Node3D = n as Node3D
+		if o == null or o == crew or not o.has_method(&"eye_position") or not rt.is_ancestor_of(o):
+			continue
+		if o is CrewController:
+			continue
+		_check(o)
+
+
+func _check(o: Node3D) -> void:
+	var eye: Vector3 = o.call(&"eye_position")
+	var cpos: Vector3 = crew.global_position
+	var d: float = eye.distance_to(cpos)
+	var meter: float = rt.stealth.detection_value(o, crew.slot)
+	if d > 40.0 and meter <= 0.0:
+		return
+	var res: Array = _glass_only(o, eye)
+	var key: String = String(o.name)
+	if not bool(res[0]):
+		if meter <= 0.0:
+			_seen[key] = -1
+		return
+	var pane: String = String(res[1])
+	if meter > 0.0:
+		var qtr: int = int(meter * 4.0)
+		if qtr > int(_seen.get(key, -1)):
+			_seen[key] = qtr
+			_row("SEEN %s (%s) meter %.2f through %s: pilot %s crouched %s, observer %s, %.1f m" % [key, _kind(o), meter,
+				pane, _v(cpos), crew.crouched, _v(o.global_position), d])
+		var pk: Array = _peak.get(key, [0.0, "", "", ""]) as Array
+		if meter > float(pk[0]):
+			_peak[key] = [meter, pane, _v(cpos), _v(o.global_position)]
+		return
+	_seen[key] = -1
+	if d > LOS_LOG_M:
+		return
+	var fwd: Vector3 = -o.global_transform.basis.z
+	var to: Vector3 = cpos - o.global_position
+	var ang: float = rad_to_deg(absf(Vector2(fwd.x, fwd.z).angle_to(Vector2(to.x, to.z))))
+	if ang > HALF_ANGLE_DEG:
+		return
+	var t: float = rt.heist_time_s
+	if t - float(_los_t.get(key, -1000.0)) < LOS_REPEAT_S:
+		return
+	_los_t[key] = t
+	_row("LOS %s (%s) glass-only line, meter 0, %.1f m ang %.0f through %s: pilot %s crouched %s, observer %s" % [key,
+		_kind(o), d, ang, pane, _v(cpos), crew.crouched, _v(o.global_position)])
+
+
+## [glass_only, first see-through pane name]
+func _glass_only(o: Node3D, eye: Vector3) -> Array:
+	var space: PhysicsDirectSpaceState3D = get_viewport().world_3d.direct_space_state
+	var ex: Array[RID] = []
+	var co: CollisionObject3D = o as CollisionObject3D
+	if co != null:
+		ex.append(co.get_rid())
+	ex.append(crew.get_rid())
+	var any_glass: bool = false
+	var pane: String = ""
+	for h: float in HEIGHTS:
+		var to: Vector3 = crew.global_position + Vector3.UP * minf(h, crew.eye_height())
+		_q.from = eye
+		_q.to = to
+		_q.exclude = ex
+		var hit: Dictionary = space.intersect_ray(_q)
+		if hit.is_empty():
+			return [false, ""]
+		var body: Node = hit.get("collider") as Node
+		if body == null or not body.is_in_group(StealthDirector.GROUP_SEE_THROUGH):
+			continue
+		_q.exclude = ex
+		if StealthDirector.vision_clear(space, _q):
+			any_glass = true
+			if pane == "":
+				pane = _pane_name(body)
+	return [any_glass, pane]
+
+
+func _pane_name(body: Node) -> String:
+	var s: String = str(body.get_path())
+	var i: int = s.find("/Geometry/")
+	if i < 0:
+		i = s.find("/Gameplay/")
+	return s.substr(i + 1) if i >= 0 else s
+
+
+func summary() -> void:
+	for k: Variant in _peak:
+		var pk: Array = _peak[k] as Array
+		_row("SUMMARY %s peak meter via glass %.2f through %s (pilot %s, observer %s)" % [k, pk[0], pk[1], pk[2], pk[3]])
+	if _peak.is_empty():
+		_row("SUMMARY no glass-only sighting with meter > 0")
+
+
+func _kind(o: Node3D) -> String:
+	if o is SecurityCamera:
+		return "camera"
+	if o is NpcBase:
+		return "guard" if (o as NpcBase).is_in_group(&"guard") or String(o.name).contains("guard") else "civilian"
+	return o.get_class()
+
+
+func _row(msg: String) -> void:
+	if log_fn.is_valid():
+		log_fn.call("[GLASS] " + msg)
+	else:
+		print("[GLASS] " + msg)
+
+
+static func _v(p: Vector3) -> String:
+	return "(%.1f, %.1f, %.1f)" % [p.x, p.y, p.z]
