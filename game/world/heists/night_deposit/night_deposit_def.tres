[gd_resource type="Resource" script_class="HeistDef" format=3]

[ext_resource type="Script" path="res://contracts/data/heist_def.gd" id="1_cet1u"]

[resource]
script = ExtResource("1_cet1u")
id = &"night_deposit"
display_name = "Night Deposit"
contact = &"contact.accountant"
briefing = "Harbor Savings & Loan, Pier District branch. Every Friday night the Ortega Fisheries Co-op drops its week of cash into the night depository, and its special customers keep more in the vault cage. The Accountant: they can't report what they never declared. Keycard and time-lock code, or hack the lock; hold the basement; four bags minimum."
map_scene = "res://world/heists/night_deposit/night_deposit.tscn"
base_payout = 90000
loot = Array[StringName]([&"loot.cash", &"loot.cash_bricks", &"loot.small_valuables"])
objectives = Array[StringName]([&"casing", &"keycard", &"code", &"server", &"vault_gate", &"time_lock", &"time_lock_wait", &"vault_loot", &"depository", &"vault_drill", &"secure", &"escape"])
