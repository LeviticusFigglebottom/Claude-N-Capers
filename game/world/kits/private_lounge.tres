[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"private_lounge"
purpose = &"living_room"
required_items = Array[StringName]([&"sofa", &"coffee_table", &"rug", &"floor_lamp", &"light_fixture"])
optional_items = {
&"picture": 1,
&"plant": 1,
&"side_table": 0.8
}
clutter_groups = {}
min_density = 0.08
max_density = 0.6
min_props = 6
lone_ok_kinds = Array[StringName]([&"plant", &"floor_lamp", &"piano", &"armchair", &"side_table", &"sofa"])
seed_salt = 321
seed_id = &"lounge_exec"
counts = {}
assets = {
&"bin": PackedStringArray("prop_bin_office"),
&"fire_extinguisher": PackedStringArray("prop_fire_extinguisher"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_c", "prop_wall_art_b"),
&"plant": PackedStringArray("prop_plant_tall"),
&"rug": PackedStringArray("prop_rug_rect")
}
ceiling = {"prop_downlight": 2.6}
notes = "Afterhours (living_room), from lounge_exec: AH U12 Crale's private room: a sofa, a rug, lamps; the product shelving and the laser grid are the map's."
