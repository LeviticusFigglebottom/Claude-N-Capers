[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"office_partner"
purpose = &"office"
required_items = Array[StringName]([&"desk", &"chair", &"picture", &"plant", &"bookshelf", &"light_fixture"])
optional_items = {
&"credenza": 0.3,
&"floor_lamp": 0.8,
&"picture": 1,
&"rug": 0.8,
&"side_table": 0.5
}
clutter_groups = {
&"desk": {
"anchors": Array[StringName]([&"desk"]),
"count": Vector2i(1, 2),
"items": {&"desk_lamp": 1.5, &"notebook": 1.5, &"papers": 2, &"pen_cup": 1},
"radius": 0.6
}
}
min_density = 0.2
max_density = 1.2
min_props = 10
lone_ok_kinds = Array[StringName]([&"plant", &"floor_lamp", &"sofa", &"table"])
seed_salt = 303
counts = {
&"picture": Vector2i(2, 3)
}
assets = {
&"bin": PackedStringArray("prop_bin_office"),
&"bookshelf": PackedStringArray("prop_bookcase_w160"),
&"credenza": PackedStringArray("prop_credenza_w200"),
&"fire_extinguisher": PackedStringArray("prop_fire_extinguisher"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_c", "prop_wall_art_b"),
&"plant": PackedStringArray("prop_plant_tall"),
&"rug": PackedStringArray("prop_rug_rect")
}
ceiling = {"prop_downlight": 2.4}
notes = "K1 Kessler / K5 Moor: the walnut desk, chair, credenza, sofa, shelves or meeting table are map-built (the laptop, keycard and planner slots stay clear). Downlight pools, art, plants, a desk lamp."
