[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"study_exec"
purpose = &"office"
required_items = Array[StringName]([&"rug", &"desk", &"chair", &"bookshelf", &"credenza", &"coffee_table", &"armchair", &"floor_lamp", &"picture", &"desk_lamp", &"light_fixture"])
optional_items = {
&"bookshelf": 0.5,
&"picture": 1,
&"plant": 0.8,
&"side_table": 0.6,
&"wall_safe": 0.2
}
clutter_groups = {
&"credenza": {
"anchors": Array[StringName]([&"credenza"]),
"count": Vector2i(1, 2),
"items": {&"binders": 0.6, &"bust": 1, &"plant_small": 1, &"table_lamp": 1},
"radius": 0.4
},
&"desk": {
"anchors": Array[StringName]([&"desk"]),
"count": Vector2i(2, 3),
"items": {&"binders": 0.8, &"laptop": 1.2, &"mug": 1.5, &"notebook": 1.5, &"papers": 3, &"pen_cup": 1.2, &"plant_small": 0.5},
"radius": 0.6
},
&"side": {
"anchors": Array[StringName]([&"side_table"]),
"count": Vector2i(1, 1),
"items": {&"plant_small": 1, &"table_lamp": 1.2},
"radius": 0.3
}
}
min_density = 0.25
max_density = 1.8
min_props = 15
lone_ok_kinds = Array[StringName]([])
seed_salt = 216
counts = {
&"bookshelf": Vector2i(2, 4),
&"chair": Vector2i(3, 3)
}
assets = {
&"chair": PackedStringArray("prop_chair_task", "prop_chair_visitor", "prop_chair_visitor"),
&"desk": PackedStringArray("prop_desk_exec"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_b", "prop_wall_art_c"),
&"plant": PackedStringArray("prop_plant_tall"),
&"rug": PackedStringArray("prop_rug_rect")
}
ceiling = {"prop_downlight": 2.4}
notes = "M4 senior partner's study: executive desk (task chair 0.47 m + two visitor chairs), bookshelves, credenza, a reading armchair at a low table on the rug, floor lamp, art. Warm downlights."
