counts = {}
assets = {
&"shelving": PackedStringArray("prop_shelving_archive")
}
ceiling = {}
notes = "Safehouse ST store (3.5 x 4.5 m; the G0's electrical_closet + storage_archive): the breaker panel, Mercer's router / NAS rack, shelving with print-works archive boxes, the water heater (tank) where it fits."
