[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"office_open_tower"
purpose = &"office"
required_items = Array[StringName]([&"desk", &"chair", &"monitor", &"keyboard", &"file_cabinet", &"printer", &"water_cooler", &"plant", &"light_fixture"])
optional_items = {
&"bin": 1,
&"bookshelf": 0.6,
&"credenza": 0.5,
&"desk_lamp": 0.6,
&"picture": 1,
&"plant": 1
}
clutter_groups = {
&"desk": {
"anchors": Array[StringName]([&"desk"]),
"count": Vector2i(2, 3),
"items": {&"binders": 0.8, &"laptop": 1.2, &"mug": 1.5, &"notebook": 1.5, &"papers": 3, &"pen_cup": 1.2, &"plant_small": 0.5},
"radius": 0.6
}
}
min_density = 0.2
max_density = 1.5
min_props = 22
lone_ok_kinds = Array[StringName]([&"plant", &"water_cooler", &"printer"])
seed_salt = 208
counts = {
&"chair": Vector2i(4, 6),
&"desk": Vector2i(4, 6),
&"file_cabinet": Vector2i(2, 3),
&"keyboard": Vector2i(3, 6),
&"monitor": Vector2i(3, 6),
&"plant": Vector2i(2, 3)
}
assets = {
&"bin": PackedStringArray("prop_bin_office"),
&"chair": PackedStringArray("prop_chair_office"),
&"desk": PackedStringArray("prop_desk_office"),
&"light_fixture": PackedStringArray("prop_ceiling_panel_neutral"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_b", "prop_notice_frame"),
&"plant": PackedStringArray("prop_plant_tall")
}
ceiling = {"prop_ceiling_panel_neutral": 2.4}
notes = "K8 paralegal open office: wall desks with swivel chairs and monitors, file cabinets, printer, water cooler, plants. 4000 K panels."
