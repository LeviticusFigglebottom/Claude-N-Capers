&"light_fixture": PackedStringArray("prop_ceiling_panel_neutral"),
&"picture": PackedStringArray("prop_notice_frame")
}
ceiling = {"prop_ceiling_panel_neutral": 3}
notes = "Back-of-house corridors and lobbies (G4, G10, U8): wall-mounted only, the floor stays clear (>= 0.9 m service width). 4000 K panels. Exit signs centre at 2.32 m over doors."
