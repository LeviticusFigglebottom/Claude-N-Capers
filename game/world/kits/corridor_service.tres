optional_items = {
&"outlet": 1,
&"picture": 1,
&"switch": 1.5,
&"thermostat": 0.5
}
clutter_groups = {}
min_density = 0.05
max_density = 1.2
min_props = 3
lone_ok_kinds = Array[StringName]([])
