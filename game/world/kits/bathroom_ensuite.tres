[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"bathroom_ensuite"
purpose = &"restroom"
required_items = Array[StringName]([&"toilet", &"sink", &"mirror", &"soap_dispenser", &"paper_dispenser", &"light_fixture"])
optional_items = {
&"bin": 0.6,
&"grab_bar": 0.3
}
clutter_groups = {}
min_density = 0.4
max_density = 3
min_props = 6
lone_ok_kinds = Array[StringName]([])
seed_salt = 218
counts = {}
assets = {
&"bin": PackedStringArray("prop_bin_small"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"mirror": PackedStringArray("prop_mirror_restroom")
}
ceiling = {"prop_downlight": 1.8}
notes = "M6 en-suite: WC with paper, vanity with mirror and soap. Warm downlights."
