[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"dining_exec"
purpose = &"dining_room"
required_items = Array[StringName]([&"rug", &"table", &"chair", &"credenza", &"picture", &"plant", &"light_fixture"])
optional_items = {
&"floor_lamp": 0.4,
&"picture": 1,
&"plant": 0.6,
&"vitrine": 0.3
}
clutter_groups = {
&"credenza": {
"anchors": Array[StringName]([&"credenza"]),
"count": Vector2i(1, 2),
"items": {&"binders": 0.6, &"bust": 1, &"plant_small": 1, &"table_lamp": 1},
"radius": 0.4
},
&"table": {
"anchors": Array[StringName]([&"table"]),
"count": Vector2i(0, 1),
"items": {&"bottles": 1},
"radius": 0.5
}
}
min_density = 0.2
max_density = 1.6
min_props = 16
lone_ok_kinds = Array[StringName]([&"table"])
seed_salt = 220
counts = {
&"chair": Vector2i(6, 8),
&"picture": Vector2i(2, 3),
&"plant": Vector2i(1, 2)
}
assets = {
&"chair": PackedStringArray("prop_chair_dining"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_b", "prop_wall_art_c"),
&"plant": PackedStringArray("prop_plant_tall"),
&"rug": PackedStringArray("prop_rug_dining"),
&"table": PackedStringArray("prop_table_dining")
}
ceiling = {"prop_chandelier_ring": 12, "prop_downlight": 2.6}
notes = "M8 partners' dining room: 2.4 m walnut table on a 4 x 3 m rug with up to eight upholstered chairs, a credenza as sideboard, art, the ring chandelier centred over the room + downlights. If the map anchors the table, anchor the rug under it too."
