"count": Vector2i(2, 4),
"items": {&"binders": 1, &"kettle": 1, &"mug": 2, &"notebook": 1.5, &"papers": 3, &"pen_cup": 1.5, &"plant_small": 0.6},
"radius": 0.6
},
&"floor": {
"anchors": Array[StringName]([&"wall", &"door"]),
"count": Vector2i(0, 1),
"items": {&"bag": 1, &"bin": 2, &"box": 1},
"radius": 0.8
}
}
