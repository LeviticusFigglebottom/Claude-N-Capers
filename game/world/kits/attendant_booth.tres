&"bin": PackedStringArray("prop_bin_office"),
&"chair": PackedStringArray("prop_chair_office"),
&"desk": PackedStringArray("prop_desk_office"),
&"heater": PackedStringArray("prop_radiator_heater"),
&"key_cabinet": PackedStringArray("prop_key_cabinet"),
&"light_fixture": PackedStringArray("prop_ceiling_panel_neutral"),
&"picture": PackedStringArray("prop_notice_frame")
}
ceiling = {"prop_ceiling_panel_neutral": 2.4}
notes = "Rolling Thunder (office), from security_office: RT AB car-park attendant booth (5 x 6 m, windows N and W): the attendant's desk and chair are map-built (BoothDesk, a seated spawn); the kit adds the heater, key cabinet, monitor and kettle."
