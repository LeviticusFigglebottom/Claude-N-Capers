&"chair": PackedStringArray("prop_chair_dining"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_b"),
&"rug": PackedStringArray("prop_rug_rect"),
&"table": PackedStringArray("prop_table_dining")
}
ceiling = {"prop_downlight": 2.4}
notes = "K19 law library: walnut bookshelves round the walls, a reading table with upholstered chairs, a credenza with the desk lamp, an armchair at a low table on the rug. Warm downlights."
