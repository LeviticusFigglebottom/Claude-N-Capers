"count": Vector2i(1, 1),
"items": {&"plant_small": 1, &"table_lamp": 1.2},
"radius": 0.3
},
&"table": {
"anchors": Array[StringName]([&"table"]),
"count": Vector2i(1, 2),
"items": {&"binders": 1, &"notebook": 2, &"papers": 1.5},
"radius": 0.5
}
}
min_density = 0.3
