[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"locker_room"
purpose = &"locker_room"
required_items = Array[StringName]([&"lockers", &"bench", &"sink", &"mirror", &"bin", &"light_fixture"])
optional_items = {
&"bag": 0.6,
&"hand_dryer": 1,
&"soap_dispenser": 1
}
clutter_groups = {}
min_density = 0.3
max_density = 1.8
min_props = 9
lone_ok_kinds = Array[StringName]([&"bench"])
seed_salt = 50
counts = {
&"lockers": Vector2i(3, 4),
&"sink": Vector2i(2, 2)
}
assets = {
&"bench": PackedStringArray("prop_bench_corridor"),
&"bin": PackedStringArray("prop_bin_small"),
&"light_fixture": PackedStringArray("prop_fluorescent"),
&"mirror": PackedStringArray("prop_mirror_restroom")
}
ceiling = {"prop_fluorescent": 2.4}
notes = "B2 staff locker room (the branch's only restrooms are the B13 WCs): lockers, bench, sink row with mirrors, dryer."
