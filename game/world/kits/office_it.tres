"count": Vector2i(1, 3),
"items": {&"binders": 1, &"desk_phone": 0.5, &"mug": 1.5, &"notebook": 1, &"papers": 3, &"pen_cup": 1},
"radius": 0.6
},
&"floor": {
"anchors": Array[StringName]([&"wall"]),
"count": Vector2i(1, 2),
"items": {&"box": 2},
"radius": 0.8
}
}
