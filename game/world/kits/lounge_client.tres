[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"lounge_client"
purpose = &"lobby"
required_items = Array[StringName]([&"armchair", &"sofa", &"table", &"counter", &"plant", &"picture", &"light_fixture", &"coffee_machine", &"side_table", &"table_lamp"])
optional_items = {
&"leaflet_rack": 0.5,
&"wall_lamp": 1
}
clutter_groups = {
&"counter": {
"anchors": Array[StringName]([&"counter"]),
"count": Vector2i(2, 4),
"items": {&"coffee_machine": 1, &"glassware": 1, &"mug": 2},
"radius": 0.6
}
}
min_density = 0.15
max_density = 1.0
min_props = 15
lone_ok_kinds = Array[StringName]([&"plant", &"armchair", &"sofa", &"side_table"])
seed_salt = 4101
counts = {
&"armchair": Vector2i(2, 2)
}
assets = {
&"armchair": PackedStringArray("prop_armchair"),
&"light_fixture": PackedStringArray("prop_pendant_brass"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_c"),
&"plant": PackedStringArray("prop_plant_tall"),
&"sofa": PackedStringArray("prop_sofa_w200")
}
ceiling = {}
notes = "OF PC private-client lounge (OF-C2 lane B, of_art_rooms.gd): the G1 coffee table and coffee service carry exact-fit art; armchairs N / S of the table (the variant client chairs sit W / E), a sofa with side tables and lamps on the south wall, art, warm brass pendants and wall lamps. Placed from fixed tables (one room uses this kit)."
