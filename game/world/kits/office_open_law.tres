[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"office_open_law"
purpose = &"office"
required_items = Array[StringName]([&"desk", &"chair", &"monitor", &"keyboard", &"printer", &"file_cabinet", &"water_cooler", &"plant", &"whiteboard", &"light_fixture"])
optional_items = {
&"bin": 1,
&"box": 0.5,
&"bulletin_board": 0.6,
&"coat_rail": 0.6,
&"file_cabinet": 1.5,
&"picture": 1,
&"plant": 1,
&"printer": 1.2
}
clutter_groups = {
&"desk": {
"anchors": Array[StringName]([&"desk"]),
"count": Vector2i(4, 7),
"items": {&"binders": 1.5, &"desk_lamp": 0.4, &"desk_phone": 1, &"mug": 2, &"notebook": 1, &"papers": 3, &"pen_cup": 1, &"plant_small": 0.6},
"radius": 1.1
},
&"floor": {
"anchors": Array[StringName]([&"wall", &"door"]),
"count": Vector2i(0, 1),
"items": {&"bin": 2, &"box": 1},
"radius": 0.8
}
}
min_density = 0.2
max_density = 1.2
min_props = 16
lone_ok_kinds = Array[StringName]([&"plant", &"water_cooler", &"printer", &"coat_rail", &"file_cabinet"])
seed_salt = 307
counts = {
&"file_cabinet": Vector2i(3, 4),
&"keyboard": Vector2i(8, 12),
&"monitor": Vector2i(10, 12),
&"printer": Vector2i(2, 2)
}
assets = {
&"bin": PackedStringArray("prop_bin_office"),
&"fire_extinguisher": PackedStringArray("prop_fire_extinguisher"),
&"light_fixture": PackedStringArray("prop_ceiling_panel_neutral"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_c", "prop_wall_art_b"),
&"plant": PackedStringArray("prop_plant_tall"),
&"printer": PackedStringArray("prop_printer_mfp"),
&"rug": PackedStringArray("prop_rug_rect"),
&"whiteboard": PackedStringArray("prop_whiteboard")
}
ceiling = {"prop_ceiling_panel_neutral": 2.6}
notes = "K8 associates' open plan: three map-built four-seat bench pods (12 chairs, fabric spine screens) and the printer; the kit puts screens, keyboards and a working day's clutter on the pods, a second printer, cabinets, a whiteboard, a cooler, plants. C11 sightlines stay clear."
