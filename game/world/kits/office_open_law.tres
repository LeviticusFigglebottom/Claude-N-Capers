[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"office_open_law"
purpose = &"office"
required_items = Array[StringName]([&"desk", &"chair", &"monitor", &"keyboard", &"printer", &"file_cabinet", &"water_cooler", &"plant", &"light_fixture"])
optional_items = {
&"bin": 1,
&"coat_rail": 0.5,
&"picture": 1,
&"plant": 1
}
clutter_groups = {
&"desk": {
"anchors": Array[StringName]([&"desk"]),
"count": Vector2i(1, 3),
"items": {&"binders": 1, &"desk_phone": 0.5, &"mug": 1.5, &"notebook": 1, &"papers": 3, &"pen_cup": 1},
"radius": 0.6
},
&"floor": {
"anchors": Array[StringName]([&"wall", &"door"]),
"count": Vector2i(0, 1),
"items": {&"bin": 2, &"box": 1},
"radius": 0.8
}
}
min_density = 0.2
max_density = 1.2
min_props = 16
lone_ok_kinds = Array[StringName]([&"plant", &"water_cooler", &"printer", &"coat_rail"])
seed_salt = 307
counts = {
&"file_cabinet": Vector2i(2, 3),
&"keyboard": Vector2i(4, 8),
&"monitor": Vector2i(6, 10)
}
assets = {
&"bin": PackedStringArray("prop_bin_office"),
&"fire_extinguisher": PackedStringArray("prop_fire_extinguisher"),
&"light_fixture": PackedStringArray("prop_ceiling_panel_neutral"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_c", "prop_wall_art_b"),
&"plant": PackedStringArray("prop_plant_tall"),
&"printer": PackedStringArray("prop_printer_mfp"),
&"rug": PackedStringArray("prop_rug_rect")
}
ceiling = {"prop_ceiling_panel_neutral": 2.6}
notes = "K8 associates' open plan: three map-built four-seat bench pods (12 chairs) and the printer; the kit puts screens and keyboards on the pods, cabinets, a cooler, plants. C11 sightlines stay clear."
