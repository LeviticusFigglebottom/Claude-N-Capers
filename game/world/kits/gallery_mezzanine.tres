[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"gallery_mezzanine"
purpose = &"lobby"
required_items = Array[StringName]([&"plinth", &"picture", &"bench", &"plant", &"light_fixture"])
optional_items = {
&"picture": 1,
&"plant": 0.5,
&"plinth": 1,
&"vitrine": 0.6
}
clutter_groups = {}
min_density = 0.12
max_density = 1.5
min_props = 8
lone_ok_kinds = Array[StringName]([&"plinth", &"bench", &"plant", &"vitrine"])
seed_salt = 214
counts = {
&"picture": Vector2i(2, 4),
&"plinth": Vector2i(2, 3)
}
assets = {
&"bench": PackedStringArray("prop_bench_upholstered"),
&"light_fixture": PackedStringArray("prop_track_light"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_b", "prop_wall_art_c"),
&"plant": PackedStringArray("prop_plant_tall")
}
ceiling = {"prop_track_light": 3}
notes = "M2 gallery mezzanine (L-shape: pass the bounding box + a keep-out for the missing corner, and the railing edge): plinths, art on the walls, an upholstered bench, track lights. Busts do not stand on plinths (bust hosts: counter_service / table / credenza)."
