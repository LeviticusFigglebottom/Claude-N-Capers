&"cocktail_table": PackedStringArray("prop_cocktail_table"),
&"light_fixture": PackedStringArray("prop_chandelier_ring"),
&"plant": PackedStringArray("prop_plant_tall"),
&"stanchion": PackedStringArray("prop_stanchion_velvet")
}
