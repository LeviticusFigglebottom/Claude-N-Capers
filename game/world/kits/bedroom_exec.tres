&"picture": 0.5,
&"plant": 0.8
}
clutter_groups = {}
min_density = 0.15
max_density = 1.2
min_props = 8
lone_ok_kinds = Array[StringName]([&"plant", &"floor_lamp"])
seed_salt = 325
counts = {}
assets = {
&"bin": PackedStringArray("prop_bin_office"),
&"fire_extinguisher": PackedStringArray("prop_fire_extinguisher"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_c", "prop_wall_art_b"),
&"plant": PackedStringArray("prop_plant_tall"),
&"rug": PackedStringArray("prop_rug_rect")
}
ceiling = {"prop_downlight": 2.6}
notes = "M5 guest suite: bed, nightstands (kc_guest) and wardrobe are map-built; Kessler's armchair is an npc seat in its slot (keep-out)."
