[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"bedroom_exec"
purpose = &"bedroom"
required_items = Array[StringName]([&"bed", &"wardrobe", &"rug", &"picture", &"light_fixture"])
optional_items = {
&"armchair": 0.6,
&"coffee_table": 0.6,
&"floor_lamp": 0.6,
&"mirror": 0.4,
&"picture": 0.6,
&"plant": 0.6,
&"side_table": 0.4
}
clutter_groups = {
&"bedside": {
"anchors": Array[StringName]([&"bed"]),
"count": Vector2i(2, 2),
"items": {&"nightstand": 1},
"radius": 0.25
},
&"lamps": {
"anchors": Array[StringName]([&"nightstand"]),
"count": Vector2i(1, 1),
"items": {&"table_lamp": 1},
"radius": 0.3
}
}
min_density = 0.2
max_density = 2
min_props = 9
lone_ok_kinds = Array[StringName]([])
seed_salt = 217
counts = {}
assets = {
&"bed": PackedStringArray("prop_bed_double"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"mirror": PackedStringArray("prop_mirror_wall"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_b", "prop_wall_art_c"),
&"plant": PackedStringArray("prop_plant_tall"),
&"rug": PackedStringArray("prop_rug_rect"),
&"table_lamp": PackedStringArray("prop_lamp_bedside")
}
ceiling = {"prop_downlight": 2.4}
notes = "M5 partner's bedroom: the bed (prop_bed_double, `Pelvis` marker for the sleeping NPC) is a map anchor; two nightstands beside it with bedside lamps (clutter groups, so they hug the bed), wardrobe, rug, art. Armchair only with a coffee table (seat host)."
