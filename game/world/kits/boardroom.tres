[gd_resource type="Resource" script_class="DressingKit" load_steps=2 format=3]

[ext_resource type="Script" path="res://world/kits/dressing_kit.gd" id="1_kit"]

[resource]
script = ExtResource("1_kit")
id = &"boardroom"
purpose = &"office"
required_items = Array[StringName]([&"table", &"chair", &"credenza", &"tv", &"picture", &"plant", &"light_fixture"])
optional_items = {
&"bin": 0.2,
&"picture": 1,
&"plant": 0.5
}
clutter_groups = {
&"credenza": {
"anchors": Array[StringName]([&"credenza"]),
"count": Vector2i(1, 2),
"items": {&"binders": 0.6, &"bust": 1, &"plant_small": 1, &"table_lamp": 1},
"radius": 0.4
},
&"table": {
"anchors": Array[StringName]([&"table"]),
"count": Vector2i(2, 4),
"items": {&"laptop": 1.5, &"mug": 1, &"notebook": 1.5, &"papers": 1.5},
"radius": 0.6
}
}
min_density = 0.25
max_density = 2
min_props = 16
lone_ok_kinds = Array[StringName]([&"table"])
seed_salt = 222
counts = {
&"chair": Vector2i(8, 10)
}
assets = {
&"bin": PackedStringArray("prop_bin_office"),
&"chair": PackedStringArray("prop_chair_office"),
&"light_fixture": PackedStringArray("prop_downlight"),
&"picture": PackedStringArray("prop_wall_art_a", "prop_wall_art_b", "prop_wall_art_c"),
&"plant": PackedStringArray("prop_plant_tall"),
&"table": PackedStringArray("prop_table_boardroom")
}
ceiling = {"prop_downlight": 2.4}
notes = "M14 boardroom: 4.2 m walnut table, 8-10 swivel chairs, credenza, wall display (prop_tv_wall; the brief's 'monitor' kind only stands on desks), art, plants."
