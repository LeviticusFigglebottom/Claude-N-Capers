&"bin": 1,
&"clock": 1,
&"fire_extinguisher": 1,
&"picture": 1.5
}
clutter_groups = {
&"desk": {
"anchors": Array[StringName]([&"desk", &"counter_service"]),
"count": Vector2i(1, 3),
"items": {&"binders": 1, &"mug": 2, &"notebook": 1, &"papers": 3},
"radius": 0.6
}
}
min_density = 0.2
max_density = 1.4
min_props = 8
lone_ok_kinds = Array[StringName]([&"plant", &"water_cooler", &"bench"])
seed_salt = 201
counts = {}
assets = {
&"bin": PackedStringArray("prop_bin_office"),
&"binders": PackedStringArray("prop_binders"),
&"box": PackedStringArray("prop_box_small"),
&"bulletin_board": PackedStringArray("prop_bulletin_board"),
&"clock": PackedStringArray("prop_clock_harbor"),
&"fire_extinguisher": PackedStringArray("prop_fire_extinguisher"),
&"light_fixture": PackedStringArray("prop_ceiling_panel_neutral"),
&"mug": PackedStringArray("prop_mug"),
&"notebook": PackedStringArray("prop_notebook"),
&"papers": PackedStringArray("prop_papers"),
&"picture": PackedStringArray("prop_notice_frame"),
&"plant": PackedStringArray("prop_plant_tall"),
&"water_cooler": PackedStringArray("prop_water_cooler")
}
ceiling = {"prop_ceiling_panel_neutral": 3}
notes = "O1 Co-op front office: the reception counter, waiting bench and the receptionist's seat are map-built (the DeskCashO1 pickup sits on the counter). Tide / shift boards, the harbour clock, a cooler."
