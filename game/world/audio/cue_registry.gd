## Registry of every AudioCueDef (game/world/audio/cues.tres, generated by tools/audiogen/build.py).
class_name AudioCueRegistry
extends Resource

const DEFAULT_PATH: String = "res://world/audio/cues.tres"

@export var cues: Array[AudioCueDef] = []

var _index: Dictionary[StringName, AudioCueDef] = {}


static func load_default() -> AudioCueRegistry:
	if not ResourceLoader.exists(DEFAULT_PATH):
		return AudioCueRegistry.new()
	var reg: AudioCueRegistry = load(DEFAULT_PATH) as AudioCueRegistry
	return reg if reg != null else AudioCueRegistry.new()


func get_cue(cue_id: StringName) -> AudioCueDef:
	if _index.size() != cues.size():
		_rebuild()
	return _index.get(cue_id) as AudioCueDef


func has_cue(cue_id: StringName) -> bool:
	return get_cue(cue_id) != null


func ids() -> Array[StringName]:
	var out: Array[StringName] = []
	for c: AudioCueDef in cues:
		out.append(c.id)
	return out


func _rebuild() -> void:
	_index.clear()
	for c: AudioCueDef in cues:
		if c != null:
			_index[c.id] = c
