## Runs levelcheck modules on a loaded map and renders the markdown report. Owner: ENV C.
class_name LcRunner
extends RefCounted


## All checks in report order (level_standards §7 table order + walkthrough).
static func all_checks() -> Array[LcCheck]:
	var out: Array[LcCheck] = [
		LcCheckContractNodes.new(), LcCheckCameras.new(), LcCheckSecureZones.new(), LcCheckFloating.new(),
		LcCheckClipping.new(), LcCheckOrientation.new(),
		LcCheckScale.new(), LcCheckSlopes.new(), LcCheckNavmesh.new(), LcCheckBarredDoors.new(), LcCheckReachability.new(),
		LcCheckWalkthrough.new(),
		LcCheckPatrols.new(), LcCheckLasers.new(), LcCheckMaterials.new(), LcCheckZfight.new(), LcCheckLights.new(),
		LcCheckViewmodelLit.new(),
		LcCheckDensity.new(), LcCheckVariety.new(), LcCheckBounds.new(), LcCheckPerf.new(),
	]
	return out


## Runs every check applicable to ctx.stage (or only those in `only`). Map must be in the tree
## and synced (LcRunner.prepare).
static func run(ctx: LcContext, only: PackedStringArray = PackedStringArray()) -> Array[LcCheck]:
	var done: Array[LcCheck] = []
	for c: LcCheck in all_checks():
		if not only.is_empty() and not (String(c.id) in only):
			continue
		if not c.applies(ctx.stage):
			c.skipped_reason = "not run at stage %s" % ctx.stage
			done.append(c)
			continue
		var t0: int = Time.get_ticks_msec()
		await c.run(ctx)
		c.elapsed_ms = Time.get_ticks_msec() - t0
		done.append(c)
	return done


## Adds the map to `parent`, matches the navigation map cell size to the baked navmesh and waits
## for physics + navigation to sync. The mission script is detached (gameplay must not start);
## processing stays enabled because disabled CollisionObjects leave the physics space.
static func prepare(map: HeistMap, parent: Node) -> LcContext:
	var mission: Node = map.get_node_or_null("Mission")
	if mission != null:
		mission.set_meta(&"_lc_had_script", mission.get_script() != null)
		mission.set_script(null)
	var nav: NavigationRegion3D = map.get_node_or_null("Navigation") as NavigationRegion3D
	var world_map: RID = parent.get_viewport().find_world_3d().navigation_map
	if nav != null and nav.navigation_mesh != null:
		NavigationServer3D.map_set_cell_size(world_map, nav.navigation_mesh.cell_size)
		NavigationServer3D.map_set_cell_height(world_map, nav.navigation_mesh.cell_height)
	parent.add_child(map)
	var ctx: LcContext = LcContext.new()
	ctx.map = map
	await ctx.tree().process_frame
	for i: int in range(4):
		await ctx.tree().physics_frame
		await ctx.tree().process_frame
	ctx.setup(map)
	return ctx


static func failed_checks(checks: Array[LcCheck]) -> PackedStringArray:
	var out: PackedStringArray = PackedStringArray()
	for c: LcCheck in checks:
		if c.skipped_reason == "" and not c.passed():
			out.append(String(c.id))
	return out


static func report_markdown(ctx: LcContext, checks: Array[LcCheck]) -> String:
	var failed: PackedStringArray = failed_checks(checks)
	var md: PackedStringArray = PackedStringArray()
	md.append("# validate_level: %s (%s)" % [ctx.heist_id if ctx.heist_id != "" else String(ctx.map.name), ctx.stage])
	md.append("")
	md.append("Generated by `tools/levelcheck/validate_all.sh` / `res://world/tools/validate_level.tscn`. Spec:")
	md.append("docs/design/level_standards.md §7; algorithms: tools/levelcheck/README.md.")
	md.append("")
	md.append("**Result: %s** (%d check(s) failed%s)" % ["PASS" if failed.is_empty() else "FAIL", failed.size(),
		", variants: all" if ctx.variants_all else ""])
	md.append("")
	md.append("| check | result | fails | warnings |")
	md.append("|---|---|---|---|")
	for c: LcCheck in checks:
		var res: String = "skipped" if c.skipped_reason != "" else ("PASS" if c.passed() else "**FAIL**")
		md.append("| %s | %s | %d | %d |" % [c.id, res, c.fail_count(), c.warn_count()])
	for c2: LcCheck in checks:
		if c2.skipped_reason != "":
			continue
		md.append("")
		md.append("## %s: %s" % [c2.id, c2.title])
		md.append("")
		for n: String in c2.notes:
			md.append(n if n.begins_with("|") else "- " + n)
		if not c2.notes.is_empty():
			md.append("")
		for i: Dictionary in c2.sorted_issues():
			md.append("- " + LcCheck.issue_line(i))
	md.append("")
	return "\n".join(md)
