## walkthrough: the level_standards §6 walkthrough bot (pure navmesh path queries until ENV A's
## nav + CrewIntent exist). From each PLAYER spawn, path to every objective, loot spawn, secure
## zone, escape zone and UsePoint. Fails on unreachable targets and on suspicious detours
## (path > 3x straight-line distance, with a 3 m floor on the straight distance) unless the pair
## is whitelisted in game/world/heists/<id>/walkthrough_whitelist.txt. Writes walkthrough.md.
class_name LcCheckWalkthrough
extends LcCheck

const DETOUR_RATIO: float = 3.0
const MIN_STRAIGHT: float = 3.0

var rows: PackedStringArray = PackedStringArray()


func _init() -> void:
	id = &"walkthrough"
	title = "Walkthrough bot"


func run(ctx: LcContext) -> void:
	rows.clear()
	if not ctx.has_navmesh():
		fail(ctx, ctx.map, null, "no navmesh; walkthrough not run")
		_write(ctx)
		return
	await ctx.set_variant_config(LcCheckReachability.baseline(ctx))
	var targets: Array[Dictionary] = LcTargets.collect(ctx)
	var spawns: Array[SpawnPoint] = LcTargets.player_spawns(ctx)
	var ok: int = 0
	var total: int = 0
	for sp: SpawnPoint in spawns:
		for t: Dictionary in targets:
			total += 1
			var goal: Vector3 = t["pos"]
			var path: PackedVector3Array = ctx.nav_path(sp.global_position, goal)
			var straight: float = sp.global_position.distance_to(goal)
			var length: float = LcGeom.path_length(path)
			var status: String = "ok"
			var listed: bool = whitelisted(ctx.walkthrough_whitelist, sp, ctx.node_path(sp), t["node"], String(t["name"]))
			if not LcCheckReachability.reached(path, goal):
				status = "UNREACHABLE"
				fail(ctx, t["node"], goal, "%s unreachable from `%s`" % [t["kind"], ctx.node_path(sp)])
			elif length > DETOUR_RATIO * maxf(straight, MIN_STRAIGHT):
				if listed:
					status = "detour (whitelisted)"
				else:
					status = "DETOUR"
					fail(ctx, t["node"], goal, "%s path from `%s` is %.1f m for %.1f m straight (> %.0fx); whitelist if intended"
						% [t["kind"], ctx.node_path(sp), length, straight, DETOUR_RATIO])
			if status.begins_with("ok") or status.ends_with("(whitelisted)"):
				ok += 1
			rows.append("| `%s` | `%s` | %s | %.1f | %.1f | %.2f | %s |" % [ctx.node_path(sp), t["name"], t["kind"],
				straight, length, length / maxf(straight, 0.001), status])
	await ctx.set_variant_config({})
	if spawns.is_empty():
		fail(ctx, ctx.map, null, "no PLAYER spawns")
	if targets.is_empty():
		fail(ctx, ctx.map, null, "no walkthrough targets (objectives, loot, zones, UsePoints)")
	note("%d / %d spawn->target walks ok" % [ok, total])
	_write(ctx)


static func whitelisted(lines: PackedStringArray, sp: Node, sp_path: String, t: Node, t_path: String) -> bool:
	for raw: String in lines:
		var line: String = raw.split("#")[0].strip_edges()
		if line == "":
			continue
		var parts: PackedStringArray = line.split(" ", false)
		if parts.size() < 2:
			continue
		var a: String = parts[0]
		var b: String = parts[1]
		var sp_ok: bool = a == "*" or a == sp_path or a == String(sp.name)
		var t_ok: bool = b == "*" or b == t_path or b == String(t.name)
		if sp_ok and t_ok:
			return true
	return false


func _write(ctx: LcContext) -> void:
	if ctx.walkthrough_report == "":
		return
	var md: PackedStringArray = PackedStringArray()
	md.append("# Walkthrough: %s" % (ctx.heist_id if ctx.heist_id != "" else ctx.map.name))
	md.append("")
	md.append("Generated by `tools/levelcheck/walkthrough.sh` (pure navmesh path queries, baseline variants).")
	md.append("Result: **%s** (%d failure(s))" % ["PASS" if passed() else "FAIL", fail_count()])
	md.append("")
	for n: String in notes:
		md.append("- " + n)
	md.append("")
	md.append("| spawn | target | kind | straight m | path m | ratio | status |")
	md.append("|---|---|---|---|---|---|---|")
	md.append_array(rows)
	md.append("")
	DirAccess.make_dir_recursive_absolute(ctx.walkthrough_report.get_base_dir())
	var f: FileAccess = FileAccess.open(ctx.walkthrough_report, FileAccess.WRITE)
	if f != null:
		f.store_string("\n".join(md))
		f.close()
