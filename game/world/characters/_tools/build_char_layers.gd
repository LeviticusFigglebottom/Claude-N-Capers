## D-132 D1: builds the shared character texture arrays. Owner: ENV D. See char_layers.gd for the scheme.
##
##   godot --headless --path game --import
##   godot --headless --path game --script res://world/characters/_tools/build_char_layers.gd
##   godot --headless --path game --import          # imports the arrays
##   godot --headless --path game --script res://world/characters/_tools/assemble_characters.gd
##
## Collects the plain materials (char_layers.gd ineligible_reason) of every character that gets the merge
## (CrowdLod.switch_m > 0, not in _layers/d1_exclude.json "ids", in its "only" when listed), sorted by resource
## path per size tier, and writes into res://world/characters/_layers/:
## * char_layers_<tier>_<albedo|orm|normal>.png: a grid of columns x rows tiles (layer i at column i % columns, row
##   i / columns; char_layers.gd grid_columns: up to 16 columns, the fewest unused slices), from the materials' source
##   PNGs, with a .import (importer 2d_array_texture, VRAM compressed, mipmaps) whose settings give the same block
##   formats as the 2D imports: albedo BC7 (high quality), ORM BC1, normal BC5 (blue
##   cleared + channel_pack optimized = RG, like the 2D normal-map import);
## * char_layered_<tier>.tres: the tier's ShaderMaterial (char_layered.gdshader);
## * layers.json: material path -> tier and layer, per tier the layer count and the material list.
## Files are only rewritten when their bytes change (no import churn). Exit code 1 on any error.
extends SceneTree

const Spec: GDScript = preload("res://world/characters/_tools/character_spec.gd")
const CrowdLod: GDScript = preload("res://world/characters/_tools/crowd_lod.gd")
const Layers: GDScript = preload("res://world/characters/_tools/char_layers.gd")

var _errors: int = 0


func _initialize() -> void:
	var excluded: Array[String] = Layers.excluded_ids()
	var only: Array[String] = Layers.only_ids()
	var ref: ORMMaterial3D = Layers.plain_reference()
	var by_tier: Dictionary = {}
	var kept: Dictionary = {}
	var merged_chars: int = 0
	for asset_id: String in _asset_ids():
		var packed: PackedScene = load("%s%s/%s.glb" % [Spec.ASSETS_DIR, asset_id, asset_id]) as PackedScene
		if packed == null:
			_error("could not load %s (run godot --import first)" % asset_id)
			continue
		var root: Node = packed.instantiate()
		var skel: Node = root.get_node_or_null(^"Skeleton3D")
		var meshes: Array[MeshInstance3D] = CrowdLod.source_meshes(skel) if skel != null else []
		var names: Array[String] = []
		for mi: MeshInstance3D in meshes:
			names.append(String(mi.name))
		var source: Dictionary = Spec.read_source("%s%s/SOURCE.txt" % [Spec.ASSETS_DIR, asset_id])
		if Layers.is_merged(Spec.character_id(asset_id), CrowdLod.switch_m(source, names), excluded, only):
			merged_chars += 1
			for mi: MeshInstance3D in meshes:
				for si: int in range(mi.mesh.get_surface_count()):
					var mat: Material = Layers.surface_material(mi, si)
					var why: String = Layers.ineligible_reason(mat, ref)
					if why.is_empty():
						var tier: int = (mat as ORMMaterial3D).albedo_texture.get_width()
						if not by_tier.has(tier):
							by_tier[tier] = {}
						(by_tier[tier] as Dictionary)[mat.resource_path] = true
					else:
						kept["%s (%s)" % [mat.resource_path if mat != null else "<null>", why]] = true
		root.free()
	var index: Dictionary = {"_doc": "Generated by world/characters/_tools/build_char_layers.gd; do not edit (D-132 D1).",
		"version": 1, "materials": {}, "tiers": {}}
	for tier: int in Layers.TIERS:
		var paths: Array[String] = []
		if by_tier.has(tier):
			paths.assign((by_tier[tier] as Dictionary).keys())
		paths.sort()
		if paths.is_empty():
			_remove_tier(tier)
			continue
		if paths.size() > Layers.MAX_LAYERS:
			_error("tier %d has %d layers (max %d)" % [tier, paths.size(), Layers.MAX_LAYERS])
			continue
		var cols: int = Layers.grid_columns(paths.size())
		var rows: int = (paths.size() + cols - 1) / cols
		for map: String in Layers.MAPS:
			_write_grid(tier, map, paths, cols, rows)
		_write_material(tier)
		(index["tiers"] as Dictionary)[str(tier)] = {"layers": paths.size(), "slices": rows * cols, "columns": cols,
			"rows": rows, "materials": paths}
		for i: int in range(paths.size()):
			(index["materials"] as Dictionary)[paths[i]] = {"tier": tier, "layer": i}
	_write_if_changed(Layers.INDEX_PATH, (JSON.stringify(index, "\t", true) + "\n").to_utf8_buffer())
	var kept_list: Array = kept.keys()
	kept_list.sort()
	for k: Variant in kept_list:
		print("build_char_layers: kept as its own surface: %s" % k)
	print("build_char_layers: %d merged character(s), %d plain material(s), %d other, %d error(s)" % [
		merged_chars, (index["materials"] as Dictionary).size(), kept_list.size(), _errors])
	quit(1 if _errors > 0 else 0)


func _error(msg: String) -> void:
	_errors += 1
	push_error("build_char_layers: " + msg)


## Same set and order as assemble_characters.gd _asset_ids.
func _asset_ids() -> Array[String]:
	var out: Array[String] = []
	var names: Array[String] = []
	names.assign(DirAccess.get_directories_at(Spec.ASSETS_DIR))
	names.sort()
	for asset_id: String in names:
		if (Spec.is_excluded(asset_id) and not Spec.TEST_SCENES.has(asset_id)) or Spec.is_prop(asset_id):
			continue
		if ResourceLoader.exists("%s%s/%s.glb" % [Spec.ASSETS_DIR, asset_id, asset_id]):
			out.append(asset_id)
	return out


func _write_grid(tier: int, map: String, paths: Array[String], cols: int, rows: int) -> void:
	var grid: Image = Image.create_empty(cols * tier, rows * tier, false, Image.FORMAT_RGB8)
	for i: int in range(paths.size()):
		var mat: ORMMaterial3D = load(paths[i]) as ORMMaterial3D
		var tex_path: String = Layers.map_texture(mat, map).resource_path
		var img: Image = Image.load_from_file(ProjectSettings.globalize_path(tex_path))
		if img == null or img.is_empty() or img.get_width() != tier or img.get_height() != tier:
			_error("%s: %s is not %dx%d" % [paths[i], tex_path, tier, tier])
			continue
		if img.is_compressed():
			img.decompress()
		if map == "normal":
			img.convert(Image.FORMAT_RG8)   # the renderer rebuilds Z from XY; RG keeps the BC5 format of the 2D import
		img.convert(Image.FORMAT_RGB8)
		grid.blit_rect(img, Rect2i(0, 0, tier, tier), Vector2i((i % cols) * tier, (i / cols) * tier))
	var path: String = Layers.array_path(tier, map)
	_write_if_changed(path, grid.save_png_to_buffer())
	var params: String = "\n".join(PackedStringArray([
		"compress/mode=2",
		"compress/high_quality=%s" % ("true" if map == "albedo" else "false"),
		"compress/lossy_quality=0.7",
		"compress/uastc_level=0",
		"compress/rdo_quality_loss=0.0",
		"compress/hdr_compression=1",
		"compress/channel_pack=%d" % (1 if map == "normal" else 0),
		"mipmaps/generate=true",
		"mipmaps/limit=-1",
		"slices/horizontal=%d" % cols,
		"slices/vertical=%d" % rows,
	]))
	var imp: String = path + ".import"
	if FileAccess.file_exists(imp) and FileAccess.get_file_as_string(imp).contains("[params]\n\n" + params + "\n"):
		return   # imported with these settings already: keep Godot's own .import (no churn)
	var text: String = "[remap]\n\nimporter=\"2d_array_texture\"\ntype=\"CompressedTexture2DArray\"\nuid=\"%s\"\n\n" % [
		ResourceUID.id_to_text(_uid_for(path))]
	text += "[deps]\n\nsource_file=\"%s\"\n\n[params]\n\n%s\n" % [path, params]
	_write_if_changed(imp, text.to_utf8_buffer())


func _write_material(tier: int) -> void:
	var path: String = Layers.material_path(tier)
	var text: String = "[gd_resource type=\"ShaderMaterial\" load_steps=5 format=3 uid=\"%s\"]\n\n" % [
		ResourceUID.id_to_text(_uid_for(path))]
	text += "[ext_resource type=\"Shader\" path=\"%s\" id=\"1_shader\"]\n" % Layers.SHADER_PATH
	for i: int in range(Layers.MAPS.size()):
		text += "[ext_resource type=\"CompressedTexture2DArray\" path=\"%s\" id=\"%d_%s\"]\n" % [
			Layers.array_path(tier, Layers.MAPS[i]), i + 2, Layers.MAPS[i]]
	text += "\n[resource]\nresource_name = \"M_char_layered_%d\"\nrender_priority = 0\nshader = ExtResource(\"1_shader\")\n" % tier
	for i: int in range(Layers.MAPS.size()):
		text += "shader_parameter/texture_%s = ExtResource(\"%d_%s\")\n" % [Layers.MAPS[i], i + 2, Layers.MAPS[i]]
	_write_if_changed(path, text.to_utf8_buffer())


func _remove_tier(tier: int) -> void:
	var files: Array[String] = [Layers.material_path(tier)]
	for map: String in Layers.MAPS:
		files.append(Layers.array_path(tier, map))
		files.append(Layers.array_path(tier, map) + ".import")
	for f: String in files:
		if FileAccess.file_exists(f):
			DirAccess.remove_absolute(ProjectSettings.globalize_path(f))


func _write_if_changed(path: String, bytes: PackedByteArray) -> void:
	if FileAccess.file_exists(path) and FileAccess.get_file_as_bytes(path) == bytes:
		return
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(path.get_base_dir()))
	var f: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		_error("could not write %s" % path)
		return
	f.store_buffer(bytes)
	f.close()


## Same derivation as assemble_characters.gd (stable across machines and re-runs).
static func _uid_for(path: String) -> int:
	var hi: int = hash("uid:" + path) & 0x7fffffff
	var lo: int = hash(path + ":uid") & 0xffffffff
	return (hi << 32) | lo
