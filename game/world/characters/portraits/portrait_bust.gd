## Contact portrait bust (QB-50a). Owner: ENV D. Root script of
## world/characters/portraits/<name>/<name>_portrait.tscn, which is generated by
## tools/blender/characters/_contact_portrait.py (`scenes`) from the same table as the Cycles stills
## (assets/characters/portraits/<name>.png); never edit those scenes by hand.
##
## ContactDef.portrait_scene consumer (ENV B's ContactPortrait) instantiates this Node3D inside its
## own SubViewport (own_world_3d, transparent_bg). On _ready the bust
## * poses the character (model-space rotations about bone heads, in order: arms down from the
##   A-pose, then the head/neck attitude),
## * frames the Camera3D on a 3/4 bust from the character's eye height (Body mesh top - 0.115 m),
## * lifts the light rig (authored for eyes at 1.60 m) to the real eye height, aims each light at
##   its `target` metadata, and places the Backdrop quad (plus blind slats when `blinds`) behind.
## Static: no AnimationPlayer is played, so the pose holds.
class_name PortraitBust
extends Node3D

const AUTHORED_EYE_Y: float = 1.60
const BACKDROP_DISTANCE: float = 1.6
const SENSOR_MM: float = 36.0

## [bone, axis (model space, Godot axes), degrees], applied in order.
@export var pose: Array = []
@export var camera_target_dz: float = -0.12
@export var camera_distance: float = 1.4
## Camera yaw around the character, degrees; + = the character's left (toward model -X).
@export var camera_yaw_deg: float = 0.0
@export var camera_dz: float = 0.0
@export var camera_lens_mm: float = 85.0
## Venetian blind slats across the backdrop (The Accountant).
@export var blinds: bool = false

var eye_y: float = AUTHORED_EYE_Y


func _ready() -> void:
	var skel: Skeleton3D = get_node_or_null("Character/Skeleton3D") as Skeleton3D
	if skel != null:
		apply_pose(skel)
		var body: MeshInstance3D = skel.get_node_or_null("Body") as MeshInstance3D
		if body != null:
			var aabb: AABB = body.global_transform * body.get_aabb()
			eye_y = aabb.end.y - 0.115
	_frame()


func apply_pose(skel: Skeleton3D) -> void:
	for entry: Variant in pose:
		var e: Array = entry as Array
		var idx: int = skel.find_bone(String(e[0]))
		if idx < 0:
			push_warning("PortraitBust: no bone %s" % e[0])
			continue
		var axis: Vector3 = (e[1] as Vector3).normalized()
		var rot: Basis = Basis(axis, deg_to_rad(float(e[2])))
		var gp: Transform3D = skel.get_bone_global_pose(idx)
		var parent: int = skel.get_bone_parent(idx)
		var pg: Transform3D = skel.get_bone_global_pose(parent) if parent >= 0 else Transform3D.IDENTITY
		var local: Transform3D = pg.affine_inverse() * Transform3D(rot * gp.basis, gp.origin)
		skel.set_bone_pose_rotation(idx, local.basis.get_rotation_quaternion())


func _frame() -> void:
	var target: Vector3 = Vector3(0.0, eye_y + camera_target_dz, 0.0)
	var a: float = deg_to_rad(camera_yaw_deg)
	# Blender (sin a, cos a) in the ground plane -> Godot (x, -z)
	var cam_pos: Vector3 = target + Vector3(sin(a) * camera_distance, camera_dz, -cos(a) * camera_distance)
	var cam: Camera3D = get_node_or_null("Camera3D") as Camera3D
	if cam != null:
		cam.position = cam_pos
		cam.look_at_from_position(cam_pos, target, Vector3.UP)
		cam.fov = rad_to_deg(2.0 * atan(SENSOR_MM * 0.5 / camera_lens_mm))
		cam.current = true
	var dy: Vector3 = Vector3(0.0, eye_y - AUTHORED_EYE_Y, 0.0)
	var lights: Node = get_node_or_null("Lights")
	if lights != null:
		for l: Node in lights.get_children():
			var l3: Light3D = l as Light3D
			if l3 == null:
				continue
			l3.position += dy
			if l3.has_meta(&"target"):
				var t: Vector3 = (l3.get_meta(&"target") as Vector3) + dy
				if not l3.position.is_equal_approx(t):
					l3.look_at(t, Vector3.UP if absf((t - l3.position).normalized().y) < 0.99 else Vector3.FORWARD)
	var back: MeshInstance3D = get_node_or_null("Backdrop") as MeshInstance3D
	if back != null:
		var dir: Vector3 = (target - cam_pos).normalized()
		var c: Vector3 = target + dir * BACKDROP_DISTANCE
		back.position = c
		back.look_at(c + dir, Vector3.UP)   # QuadMesh faces +Z: look_at points -Z away from the camera
		if blinds and back.get_child_count() == 0:
			_add_blinds(back)


func _add_blinds(back: MeshInstance3D) -> void:
	var mat: StandardMaterial3D = StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.albedo_color = Color(0.03, 0.045, 0.045)
	var slat: QuadMesh = QuadMesh.new()
	slat.size = Vector2(3.2, 0.026)
	slat.material = mat
	for i: int in range(-13, 14):
		var s: MeshInstance3D = MeshInstance3D.new()
		s.name = "Slat%d" % (i + 13)
		s.mesh = slat
		s.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		s.position = Vector3(0.0, i * 0.118, 0.002)
		back.add_child(s)
