; Engine configuration file. Owner: LEAD.
config_version=5

[application]

config/name="CAPERWORKS"
config/description="Co-op heist game (working title)."
config/version="0.0.1"
run/main_scene="res://core/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Log="*res://core/log.gd"
Ids="*res://core/ids.gd"
GameRng="*res://core/game_rng.gd"
EventBus="*res://core/event_bus.gd"
Net="*res://core/net.gd"
Modifiers="*res://core/modifiers.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3

[layer_names]

3d_physics/layer_1="world_static"
3d_physics/layer_2="world_dynamic"
3d_physics/layer_3="players"
3d_physics/layer_4="npcs"
3d_physics/layer_5="hitboxes"
3d_physics/layer_6="interactables"
3d_physics/layer_7="loot"
3d_physics/layer_8="vision_blockers"
3d_physics/layer_9="bullet_penetrable"
3d_physics/layer_10="triggers"
3d_navigation/layer_1="walkable"
3d_navigation/layer_2="npc_only"
3d_navigation/layer_3="vent"
