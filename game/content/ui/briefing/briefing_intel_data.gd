## A heist's known security, scanned from its map scene (D-115 briefing intel). Owner: ENV B.
## Generated by res://content/ui/briefing/tools/intel_export.gd into
## res://content/data/briefing/intel/<heist>.tres; never edited by hand (test_briefing_intel checks the file
## still matches a fresh scan of the map). BriefingIntel.lines() turns it, the heist's HeistVariantTable and
## the difficulty into the briefing's "Known security" lines.
class_name BriefingIntelData
extends Resource

@export var heist_id: StringName = &""
## The map scene this was scanned from (HeistDef.map_scene).
@export var map_path: String = ""
## The map's HeistMap.variant_table resource path ("" = none).
@export var variants_path: String = ""
## Security outside every VariantSlot: { category (StringName): count (int) }. Categories: BriefingIntel.CATEGORIES.
@export var fixed: Dictionary = {}
## VariantSlot content, only for slot groups holding some security:
## { group (StringName): { slot_id (StringName): { "weight": float, "counts": { category: int } } } }.
## Every slot of such a group is listed (an empty "counts" is an option without that security).
@export var groups: Dictionary = {}
## Distinct safe time locks on the map (Safe.time_lock_s > 0), seconds, ascending.
@export var time_locks_s: Array[float] = []
