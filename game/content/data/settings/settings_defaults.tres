[gd_resource type="Resource" script_class="SettingsDefaults" format=3]

[ext_resource type="Script" path="res://content/settings/settings_defaults.gd" id="1"]

[resource]
script = ExtResource("1")
sections = {
"audio": {
"Master": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05},
"Music": {"type": "float", "default": 0.8, "min": 0.0, "max": 1.0, "step": 0.05},
"SFX": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05},
"Weapons": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05},
"Enemies": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05},
"World": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05},
"UI": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05},
"Voice": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05},
"Ambience": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05}
},
"video": {
"window_mode": {"type": "choice", "default": "windowed", "options": ["windowed", "fullscreen", "exclusive_fullscreen"]},
"resolution": {"type": "choice", "default": "auto", "options": ["auto", "1280x720", "1600x900", "1920x1080", "2560x1440", "3840x2160"]},
"vsync": {"type": "bool", "default": true},
"max_fps": {"type": "int", "default": 0, "min": 0, "max": 1000, "options": [0, 30, 60, 90, 120, 144, 165, 240]},
"quality_preset": {"type": "choice", "default": "high", "options": ["low", "medium", "high", "ultra", "custom"]},
"render_scale": {"type": "float", "default": 1.0, "min": 0.5, "max": 1.0, "step": 0.05},
"msaa": {"type": "choice", "default": "4x", "options": ["off", "2x", "4x", "8x"]},
"fxaa": {"type": "bool", "default": false},
"brightness": {"type": "float", "default": 1.0, "min": 0.5, "max": 1.5, "step": 0.05},
"fov": {"type": "float", "default": 75.0, "min": 60.0, "max": 100.0, "step": 1.0},
"effects_quality": {"type": "choice", "default": "high", "options": ["low", "medium", "high"]},
"shadow_quality": {"type": "choice", "default": "high", "options": ["low", "medium", "high"]}
},
"controls": {
"mouse_sensitivity_x": {"type": "float", "default": 1.0, "min": 0.1, "max": 5.0, "step": 0.05},
"mouse_sensitivity_y": {"type": "float", "default": 1.0, "min": 0.1, "max": 5.0, "step": 0.05},
"ads_sensitivity": {"type": "float", "default": 1.0, "min": 0.1, "max": 2.0, "step": 0.05},
"invert_y": {"type": "bool", "default": false},
"pad_sensitivity": {"type": "float", "default": 1.0, "min": 0.1, "max": 5.0, "step": 0.05},
"pad_deadzone": {"type": "float", "default": 0.2, "min": 0.05, "max": 0.5, "step": 0.01},
"aim_mode": {"type": "choice", "default": "hold", "options": ["hold", "toggle"]},
"crouch_mode": {"type": "choice", "default": "hold", "options": ["hold", "toggle"]},
"sprint_mode": {"type": "choice", "default": "hold", "options": ["hold", "toggle"]},
"interact_mode": {"type": "choice", "default": "hold", "options": ["hold", "toggle"]},
"scoreboard_mode": {"type": "choice", "default": "hold", "options": ["hold", "toggle"]},
"safehouse_hub": {"type": "choice", "default": "walk", "options": ["walk", "menu"]}
},
"gameplay": {
"dropin_policy": {"type": "choice", "default": "ask", "options": ["ask", "auto", "off"]},
"gore": {"type": "choice", "default": "full", "options": ["full", "reduced", "off"]}
},
"accessibility": {
"palette": {"type": "choice", "default": "default", "options": ["default", "deuteranopia", "protanopia", "tritanopia", "high_contrast"]},
"hud_scale": {"type": "float", "default": 1.0, "min": 0.75, "max": 1.5, "step": 0.05},
"subtitles": {"type": "bool", "default": true},
"subtitle_size": {"type": "choice", "default": "medium", "options": ["small", "medium", "large"]},
"subtitles_all_speakers": {"type": "bool", "default": true},
"reduce_motion": {"type": "bool", "default": false},
"screen_shake": {"type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.05},
"head_bob": {"type": "bool", "default": true}
}
}
action_order = Array[StringName]([&"move_forward", &"move_back", &"move_left", &"move_right", &"sprint", &"crouch", &"jump", &"look_up", &"look_down", &"look_left", &"look_right", &"fire", &"aim", &"reload", &"melee", &"slot_primary", &"slot_secondary", &"swap_weapon", &"interact", &"shout", &"mask_up", &"throw_item", &"deploy", &"drop_bag", &"order_menu", &"scoreboard", &"dismiss_tip", &"pause"])
