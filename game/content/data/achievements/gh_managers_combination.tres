[gd_resource type="Resource" script_class="AchievementDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://content/defs/achievement_def.gd" id="1_ach"]

[resource]
script = ExtResource("1_ach")
id = &"achievement.gh_managers_combination"
name_key = &"achievement.gh_managers_combination.name"
desc_key = &"achievement.gh_managers_combination.desc"
condition = {"event": &"heist_completed", "heist": &"glasshouse", "objectives_completed": [&"code", &"safe"], "facts_not_seen": [{"signal": &"item_picked_up", "args": {0: &"item.keycard"}}, {"signal": &"device_started", "args": {1: &"drill"}}], "count": 1}
unlock = &""
order = 713
category = &"glasshouse"
rewards = Array[StringName]([&"mask_base.theatre"])
unlocks = Array[StringName]([])
requires_facts = Array[StringName]([&"objective.safe.open_method"])
