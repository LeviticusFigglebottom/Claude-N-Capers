script = ExtResource("2_trk")
id = &"dockside_burn"
stems = "res://world/audio/music/dockside_burn"
default_for_heists = Array[StringName]([&"dockside_burn"])
unlock = &""

[sub_resource type="Resource" id="trk_shadow_ledger"]
script = ExtResource("2_trk")
id = &"shadow_ledger"
stems = "res://world/audio/music/shadow_ledger"
default_for_heists = Array[StringName]([&"shadow_ledger"])
unlock = &""

[sub_resource type="Resource" id="trk_gallery_night"]
script = ExtResource("2_trk")
id = &"gallery_night"
stems = "res://world/audio/music/gallery_night"
default_for_heists = Array[StringName]([&"gallery_night"])
unlock = &""

[sub_resource type="Resource" id="trk_vault_hymn"]
script = ExtResource("2_trk")
id = &"vault_hymn"
stems = "res://world/audio/music/vault_hymn"
default_for_heists = Array[StringName]([])
unlock = &"unlock.music.vault_hymn"

[sub_resource type="Resource" id="trk_long_con"]
script = ExtResource("2_trk")
id = &"long_con"
stems = "res://world/audio/music/long_con"
default_for_heists = Array[StringName]([])
unlock = &"unlock.music.long_con"

[sub_resource type="Resource" id="trk_last_call"]
script = ExtResource("2_trk")
id = &"last_call"
stems = "res://world/audio/music/last_call"
default_for_heists = Array[StringName]([])
unlock = &"unlock.music.last_call"

[resource]
script = ExtResource("1_cat")
table_path = "res://world/audio/music/tracks.tres"
pending = {
&"ostrander_federal": &"night_deposit"
}
tracks = Array[ExtResource("2_trk")]([SubResource("trk_glasshouse"), SubResource("trk_dockside_burn"), SubResource("trk_night_deposit"), SubResource("trk_shadow_ledger"), SubResource("trk_gallery_night"), SubResource("trk_vault_hymn"), SubResource("trk_long_con"), SubResource("trk_last_call")])
