"cost": 2000,
"favors": 2,
"reveals": [&"centrepiece", &"canvas_orchard", &"canvas_widow", &"canvas_saint"],
"tags": [&"stealth"]
},
&"asset.intel_sensors": {
"category": &"intel",
"cost": 1200,
