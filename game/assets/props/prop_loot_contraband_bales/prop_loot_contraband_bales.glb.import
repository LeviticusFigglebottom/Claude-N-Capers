[remap]

importer="scene"
type="PackedScene"

[params]

import_script/path="res://world/tools/import/glb_post_import.gd"
meshes/create_shadow_meshes=true
meshes/ensure_tangents=true
meshes/generate_lods=true
_subresources={
"materials": {
"M_pr_cardboard": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_cardboard.tres",
"use_external/path": "res://world/props/materials/pr_cardboard.tres"
},
"M_pr_glass_frosted": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_glass_frosted.tres",
"use_external/path": "res://world/props/materials/pr_glass_frosted.tres"
},
"M_pr_paper": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_paper.tres",
"use_external/path": "res://world/props/materials/pr_paper.tres"
},
"M_pr_plastic_black": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_plastic_black.tres",
"use_external/path": "res://world/props/materials/pr_plastic_black.tres"
}
}
}
