[remap]

importer="scene"
type="PackedScene"

[params]

import_script/path="res://world/tools/import/glb_post_import.gd"
meshes/create_shadow_meshes=true
meshes/ensure_tangents=true
meshes/generate_lods=true
_subresources={
"materials": {
"M_pr_canvas_ivory": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_canvas_ivory.tres",
"use_external/path": "res://world/props/materials/pr_canvas_ivory.tres"
},
"M_pr_fabric_charcoal": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_fabric_charcoal.tres",
"use_external/path": "res://world/props/materials/pr_fabric_charcoal.tres"
},
"M_pr_fabric_ivory": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_fabric_ivory.tres",
"use_external/path": "res://world/props/materials/pr_fabric_ivory.tres"
},
"M_pr_wood_dark": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_wood_dark.tres",
"use_external/path": "res://world/props/materials/pr_wood_dark.tres"
}
}
}
