[remap]

importer="scene"
type="PackedScene"

[params]

import_script/path="res://world/tools/import/glb_post_import.gd"
meshes/create_shadow_meshes=true
meshes/ensure_tangents=true
meshes/generate_lods=true
_subresources={
"materials": {
"M_pr_rug_burgundy": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_rug_burgundy.tres",
"use_external/path": "res://world/props/materials/pr_rug_burgundy.tres"
},
"M_pr_rug_ivory": {
"use_external/enabled": true,
"use_external/fallback_path": "res://world/props/materials/pr_rug_ivory.tres",
"use_external/path": "res://world/props/materials/pr_rug_ivory.tres"
}
}
}
